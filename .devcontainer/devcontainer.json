{
    "name": "sim-based-inference",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/sim-based-inference,type=bind,consistency=cached",
    "workspaceFolder": "/sim-based-inference",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "alexcvzz.vscode-sqlite",
                "GitHub.vscode-pull-request-github",
                "anthropic.claude-code"
            ]
        }
    },
    "remoteUser": "root",
    "postCreateCommand": "/bin/sh .devcontainer/post_create.sh"
}
